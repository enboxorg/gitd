{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://enbox.org/schemas/forge/org-issue-field",
  "title": "OrgIssueFieldData",
  "description": "An organization-level custom issue field",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "description": {
      "type": ["string", "null"]
    },
    "dataType": {
      "type": "string",
      "enum": ["text", "single_select", "number", "date", "multi_select"]
    },
    "visibility": {
      "type": "string",
      "enum": ["organization_members_only", "all"]
    },
    "options": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": ["string", "null"]
          },
          "color": {
            "type": "string",
            "enum": ["gray", "blue", "green", "yellow", "orange", "red", "pink", "purple"]
          },
          "priority": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": ["name", "color", "priority"],
        "additionalProperties": false
      }
    }
  },
  "required": ["name", "dataType"],
  "additionalProperties": false
}
