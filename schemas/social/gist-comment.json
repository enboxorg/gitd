{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://enbox.id/schemas/forge/gist-comment",
  "title": "GistCommentData",
  "description": "A comment on a GitHub-compatible gist",
  "type": "object",
  "properties": {
    "gistId": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "userDid": {
      "type": "string"
    },
    "createdAt": {
      "type": "string"
    },
    "updatedAt": {
      "type": "string"
    }
  },
  "required": ["gistId", "body"],
  "additionalProperties": false
}
