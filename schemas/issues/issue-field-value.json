{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://enbox.org/schemas/forge/issue-field-value",
  "title": "IssueFieldValueData",
  "description": "A custom field value attached to an issue",
  "type": "object",
  "properties": {
    "fieldId": {
      "type": "integer",
      "minimum": 1
    },
    "dataType": {
      "type": "string",
      "enum": ["text", "single_select", "number", "date", "multi_select"]
    },
    "value": {
      "oneOf": [
        { "type": "string" },
        { "type": "number" },
        {
          "type": "array",
          "items": { "type": "string" }
        }
      ]
    }
  },
  "required": ["fieldId", "dataType", "value"],
  "additionalProperties": false
}
